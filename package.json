{
  "name": "bharat-books-api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:init": "npx prisma init --output ../src/generated/prisma",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:pull": "npx prisma db pull",
    "db:generate": "npx prisma generate",
    "db:seed": "npx prisma db seed",
    "db:reset": "npx prisma migrate reset",
    "db:dev": "npm db:push && pnpm db:generate",
    "db:studio": "npx prisma studio --browser none",
    "auth:gen": "npx @better-auth/cli@latest generate --config ./better-auth.config.ts --output ./src/lib/auth-schema.prisma --yes"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.25",
    "@hono/zod-validator": "^0.9.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.25",
    "cloudinary": "^2.10.0",
    "hono": "^4.12.33",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.2",
    "prisma": "^7.9.1",
    "wrangler": "^4.118.0"
  }
}
